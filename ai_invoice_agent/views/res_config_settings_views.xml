<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_ai_overdue_invoice_agent" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.ai.overdue.invoice.agent</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="AI Invoice Agent" string="AI Invoice Agent" name="ai_invoice_agent">
                    <block title="AI Overdue Invoice Agent">
                        <setting string="API Key">
                            <field name="ai_api_key" password="True"/>
                        </setting>
                        <setting string="API URL">
                            <field name="ai_api_url"/>
                        </setting>
                        <setting string="AI Model">
                            <field name="ai_model"/>
                        </setting>
                        <setting string="Batch Limit">
                            <field name="ai_batch_limit"/>
                        </setting>
                        <setting string="Reminder Gap Days">
                            <field name="ai_reminder_gap_days"/>
                        </setting>
                        <setting string="Max Reminders">
                            <field name="ai_max_reminders"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
</odoo>
