pipeline {
    agent any

    environment {
        PYTHON = "/home/odoo/.virtualenvs/odoo19/bin/python3"
        ODOOLINT = "/home/odoo/.virtualenvs/odoo19/bin/odoolint"
        ODOO_BIN = "/home/odoo/workspace/odoo/odoo_19/odoo-bin"
        ODOO_CONFIG = "/home/odoo/workspace/odoo/odoo_19/odoo_19.conf"
        ODOO_LOG = "/home/odoo/workspace/odoo/odoo_19/odoo.log"
        DATABASE = "test"
        SOURCE_DIR = "/home/odoo/workspace/internal_project"
        REQUIREMENTS_FILE = "requirements.txt"
        PYLINT_MIN_SCORE = "3.0"
        ODOO_PORT = "8069"
    }

    stages {

        stage('Git Information') {
            steps {
                echo "=========================================="
                echo "GIT INFORMATION"
                echo "=========================================="

                sh '''
                    echo "Branch:"
                    git branch --show-current
                    echo ""
                    echo "Commit:"
                    git rev-parse HEAD
                    echo ""
                    git log -1 --pretty=%B
                    echo ""
                    git remote -v
                '''

                script {
                    def remote = sh(
                        script: 'git config --get remote.origin.url',
                        returnStdout: true
                    ).trim()

                    if (remote) {
                        def repo = remote
                            .replaceFirst(/^git@github\\.com:/, 'https://github.com/')
                            .replaceFirst(/^https?:\\/\\/github\\.com\\//, 'https://github.com/')
                            .replaceFirst(/\\.git$/, '')

                        env.GITHUB_COMMIT_URL = "${repo}/commit/${env.GIT_COMMIT}"
                    } else {
                        env.GITHUB_COMMIT_URL = ''
                    }
                }
            }
        }

        stage('Detect Changes') {
            steps {
                script {
                    /*
                     * Compare against the previous commit.
                     * This retains the original pipeline's HEAD~1 approach.
                     */
                    env.PREVIOUS_COMMIT = sh(
                        script: 'git rev-parse HEAD~1',
                        returnStdout: true
                    ).trim()

                    env.CURRENT_COMMIT = sh(
                        script: 'git rev-parse HEAD',
                        returnStdout: true
                    ).trim()

                    def changedFiles = sh(
                        script: '''
                            git diff --name-only "$PREVIOUS_COMMIT" "$CURRENT_COMMIT" |
                            sort -u
                        ''',
                        returnStdout: true
                    ).trim()

                    echo "Changed files:\n${changedFiles ?: 'None'}"

                    def modules = sh(
                        script: '''
                            git diff --name-only "$PREVIOUS_COMMIT" "$CURRENT_COMMIT" |
                            grep -v '__pycache__/' |
                            grep -v '\\.pyc$' |
                            awk -F/ 'NF >= 2 {print $1}' |
                            sort -u |
                            while read module
                            do
                                if [ -f "$module/__manifest__.py" ]; then
                                    echo "$module"
                                fi
                            done |
                            tr '\\n' ' '
                        ''',
                        returnStdout: true
                    ).trim()

                    def requirementsChanged = sh(
                        script: '''
                            git diff --name-only "$PREVIOUS_COMMIT" "$CURRENT_COMMIT" |
                            grep -E '^requirements\\.txt$' >/dev/null
                        ''',
                        returnStatus: true
                    ) == 0

                    def manifestChanged = sh(
                        script: '''
                            git diff --name-only "$PREVIOUS_COMMIT" "$CURRENT_COMMIT" |
                            grep -E '(^|/)__manifest__\\.py$' >/dev/null
                        ''',
                        returnStatus: true
                    ) == 0

                    env.CHANGED_MODULES = modules
                    env.REQUIREMENTS_CHANGED = requirementsChanged.toString()
                    env.MANIFEST_CHANGED = manifestChanged.toString()

                    /*
                     * requirements.txt is the source of truth for pip packages.
                     * A requirements change always triggers scanning and installation.
                     * Manifest changes trigger a scan when requirements.txt exists.
                     */
                    def requirementsExists = fileExists('requirements.txt')

                    env.DEPENDENCY_WORK_REQUIRED =
                        (requirementsChanged ||
                        (manifestChanged && requirementsExists))
                        .toString()

                    echo "Changed modules: ${modules ?: 'None'}"
                    echo "requirements.txt changed: ${env.REQUIREMENTS_CHANGED}"
                    echo "Odoo manifest changed: ${env.MANIFEST_CHANGED}"
                    echo "Dependency work required: ${env.DEPENDENCY_WORK_REQUIRED}"
                }
            }
        }

        stage('Pylint Check') {
            when {
                expression { return env.CHANGED_MODULES?.trim() }
            }
            steps {
                sh '''
                    set -eu
                    ${PYTHON} --version
                    ${PYTHON} -m pylint --version

                    for module in ${CHANGED_MODULES}
                    do
                        echo "Checking module: $module"
                        ${PYTHON} -m pylint \
                            --fail-under=${PYLINT_MIN_SCORE} "$module"
                    done
                '''
            }
        }

        stage('Pylint-Odoo Check') {
            when {
                expression { return env.CHANGED_MODULES?.trim() }
            }
            steps {
                script {
                    for (module in env.CHANGED_MODULES.split()) {
                        sh """
                            set -eu
                            "\${PYTHON}" -m pylint \\
                                --load-plugins=pylint_odoo \\
                                --fail-under=3.0 \\
                                "\${SOURCE_DIR}/${module}"
                        """
                    }
                }
            }
        }

        stage('Flake8 Check') {
            when {
                expression { return env.CHANGED_MODULES?.trim() }
            }
            steps {
                sh '''
                    set -eu
                    ${PYTHON} -m flake8 --version

                    for module in ${CHANGED_MODULES}
                    do
                        echo "Checking module: $module"
                        ${PYTHON} -m flake8 "$module"
                    done
                '''
            }
        }

        /*
         * Audit the declared package versions before installing them.
         * pip-audit must already be available in the configured environment.
         */
        stage('Dependency Vulnerability Scan') {
            when {
                expression {
                    return env.DEPENDENCY_WORK_REQUIRED == 'true'
                }
            }
            steps {
                sh '''
                    set -eu

                    echo "=========================================="
                    echo "DEPENDENCY VULNERABILITY SCAN"
                    echo "=========================================="

                    if [ ! -f "${WORKSPACE}/${REQUIREMENTS_FILE}" ]; then
                        echo "ERROR: ${REQUIREMENTS_FILE} was not found."
                        exit 1
                    fi

                    ${PYTHON} --version
                    ${PYTHON} -m pip_audit --version

                    echo "Auditing declared dependencies..."
                    ${PYTHON} -m pip_audit \
                        --strict \
                        -r "${WORKSPACE}/${REQUIREMENTS_FILE}"

                    echo "Dependency vulnerability scan passed."
                '''
            }
        }

        /*
         * Install packages automatically only after the declared-dependency
         * audit passes. The Odoo service must use this same Python environment.
         */
	stage('Install Python Dependencies') {
	    when {
		expression {
		    return env.DEPENDENCY_WORK_REQUIRED == 'true'
		}
	    }
	    steps {
		sh '''
		    set -eu

		    echo "=========================================="
		    echo "INSTALLING PYTHON DEPENDENCIES"
		    echo "=========================================="

		    sudo -n -u odoo "${PYTHON}" -m pip install -r "${WORKSPACE}/${REQUIREMENTS_FILE}"

		    echo "Python dependencies installed successfully."
		'''
	    }
	}

        stage('Deploy Custom Addons') {
            when {
                expression { return env.CHANGED_MODULES?.trim() }
            }
            steps {
                sh '''
                    set -eu

                    test -d "${SOURCE_DIR}"

                    for module in ${CHANGED_MODULES}
                    do
                        if [ ! -d "$module" ]; then
                            echo "ERROR: Module $module does not exist."
                            exit 1
                        fi

                        echo "Deploying module: $module"

                        sudo -n -u odoo rsync -a \
                            --delete \
                            --no-owner \
                            --no-group \
                            "$module/" \
                            "${SOURCE_DIR}/${module}/"

                        sudo -n chown -R odoo:odoo \
                            "${SOURCE_DIR}/${module}"
                    done

                    echo "Custom addons deployed."
                '''
            }
        }

        /*
         * Restart Odoo if either addons or dependencies changed.
         * A requirements-only change must restart Odoo too.
         */
        stage('Stop Odoo') {
            when {
                expression {
                    return env.CHANGED_MODULES?.trim() ||
                           env.DEPENDENCY_WORK_REQUIRED == 'true'
                }
            }
            steps {
                sh '''
                    set -eu
                    sudo -n systemctl stop odoo

                    if sudo -n systemctl is-active --quiet odoo; then
                        echo "ERROR: Odoo is still running."
                        sudo -n systemctl status odoo --no-pager || true
                        exit 1
                    fi
                '''
            }
        }

        stage('Upgrade Odoo Modules') {
            when {
                expression { return env.CHANGED_MODULES?.trim() }
            }
            steps {
                sh '''
                    set -eu

                    test -f "${ODOO_CONFIG}"
                    test -f "${ODOO_BIN}"

                    MODULES_TO_UPGRADE=$(echo "${CHANGED_MODULES}" | tr ' ' ',')

                    sudo -n -u odoo "${PYTHON}" "${ODOO_BIN}" \
                        -c "${ODOO_CONFIG}" \
                        -d "${DATABASE}" \
                        -u "${MODULES_TO_UPGRADE}" \
                        --stop-after-init
                '''
            }
        }

        stage('Start Odoo') {
            when {
                expression {
                    return env.CHANGED_MODULES?.trim() ||
                           env.DEPENDENCY_WORK_REQUIRED == 'true'
                }
            }
            steps {
                sh '''
                    set -eu
                    sudo -n systemctl start odoo

                    for i in $(seq 1 30)
                    do
                        if sudo -n systemctl is-active --quiet odoo; then
                            echo "Odoo service is active."
                            exit 0
                        fi
                        echo "Waiting for Odoo... ($i/30)"
                        sleep 1
                    done

                    sudo -n systemctl status odoo --no-pager || true
                    tail -100 "${ODOO_LOG}" || true
                    exit 1
                '''
            }
        }

        stage('Odoo Server Check') {
            when {
                expression {
                    return env.CHANGED_MODULES?.trim() ||
                           env.DEPENDENCY_WORK_REQUIRED == 'true'
                }
            }
            steps {
                sh '''
                    set -eu
                    sudo -n systemctl is-active --quiet odoo

                    for i in $(seq 1 30)
                    do
                        if ss -ltn | grep -q ":${ODOO_PORT} "; then
                            echo "Odoo port ${ODOO_PORT} is listening."
                            exit 0
                        fi
                        sleep 1
                    done

                    sudo -n systemctl status odoo --no-pager || true
                    tail -100 "${ODOO_LOG}" || true
                    exit 1
                '''
            }
        }

        stage('Odoo Health Check') {
            when {
                expression {
                    return env.CHANGED_MODULES?.trim() ||
                           env.DEPENDENCY_WORK_REQUIRED == 'true'
                }
            }
            steps {
                sh '''
                    set -eu

                    for i in $(seq 1 30)
                    do
                        if curl -fsS --max-time 5 \
                            "http://127.0.0.1:${ODOO_PORT}/web/database/selector" \
                            > /dev/null
                        then
                            echo "Odoo HTTP health check passed."
                            exit 0
                        fi
                        sleep 2
                    done

                    tail -100 "${ODOO_LOG}" || true
                    exit 1
                '''
            }
        }
    }

    post {
        always {
            echo "=========================================="
            echo "PIPELINE FINISHED"
            echo "=========================================="
        }

        success {
            emailext(
                recipientProviders: [developers()],
                subject: "[Jenkins] SUCCESS - ${env.JOB_NAME} #${env.BUILD_NUMBER}",
                mimeType: 'text/html',
                body: """
<html>
<body>
<p>Hello,</p>
<p>The Jenkins pipeline has completed successfully.</p>
<table>
<tr><td><b>Status:</b></td><td>SUCCESS</td></tr>
<tr><td><b>Job:</b></td><td>${env.JOB_NAME}</td></tr>
<tr><td><b>Build:</b></td><td>#${env.BUILD_NUMBER}</td></tr>
<tr><td><b>Branch:</b></td><td>${env.BRANCH_NAME ?: env.GIT_BRANCH ?: 'Unknown'}</td></tr>
<tr><td><b>Commit:</b></td><td>${env.GIT_COMMIT ?: 'Unknown'}</td></tr>
<tr><td><b>Changed modules:</b></td><td>${env.CHANGED_MODULES ?: 'None'}</td></tr>
<tr><td><b>Requirements changed:</b></td><td>${env.REQUIREMENTS_CHANGED ?: 'false'}</td></tr>
<tr><td><b>Manifest changed:</b></td><td>${env.MANIFEST_CHANGED ?: 'false'}</td></tr>
</table>
<p>Dependency checks run when dependency declarations change. Addon deployment and module upgrades run when Odoo modules change.</p>
<p><a href="${env.GITHUB_COMMIT_URL ?: '#'}">GitHub commit</a></p>
<p><a href="${env.BUILD_URL}">Jenkins build</a></p>
<p>Regards,<br>Jenkins CI/CD</p>
</body>
</html>
""",
                attachLog: false
            )
        }

        failure {
            emailext(
                recipientProviders: [developers()],
                subject: "[Jenkins] FAILED - ${env.JOB_NAME} #${env.BUILD_NUMBER}",
                mimeType: 'text/html',
                body: """
<html>
<body>
<p>Hello,</p>
<p>The Jenkins pipeline has <b>failed</b>.</p>
<table>
<tr><td><b>Status:</b></td><td>FAILED</td></tr>
<tr><td><b>Job:</b></td><td>${env.JOB_NAME}</td></tr>
<tr><td><b>Build:</b></td><td>#${env.BUILD_NUMBER}</td></tr>
<tr><td><b>Branch:</b></td><td>${env.BRANCH_NAME ?: env.GIT_BRANCH ?: 'Unknown'}</td></tr>
<tr><td><b>Commit:</b></td><td>${env.GIT_COMMIT ?: 'Unknown'}</td></tr>
<tr><td><b>Changed modules:</b></td><td>${env.CHANGED_MODULES ?: 'None'}</td></tr>
<tr><td><b>Requirements changed:</b></td><td>${env.REQUIREMENTS_CHANGED ?: 'false'}</td></tr>
<tr><td><b>Manifest changed:</b></td><td>${env.MANIFEST_CHANGED ?: 'false'}</td></tr>
</table>
<p>The pipeline stopped because a stage returned an error. Review the Jenkins console log for the failed stage.</p>
<p><a href="${env.GITHUB_COMMIT_URL ?: '#'}">GitHub commit</a></p>
<p><a href="${env.BUILD_URL}">Jenkins build and console output</a></p>
<p>Odoo log: ${env.ODOO_LOG}</p>
<p>Regards,<br>Jenkins CI/CD</p>
</body>
</html>
""",
                attachLog: true
            )
        }
    }
}

