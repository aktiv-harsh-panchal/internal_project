pipeline {

    agent any

    options {
        skipDefaultCheckout(true)
        buildDiscarder(logRotator(numToKeepStr: '10'))
        disableConcurrentBuilds()
    }

    environment {
        GITHUB_BRANCH = "staging"
        PYTHON = "/home/odoo/.virtualenvs/odoo19/bin/python3"
        ODOO_BIN = "/home/odoo/workspace/odoo/odoo_19/odoo-bin"
        ODOO_CONFIG = "/home/odoo/workspace/odoo/odoo_19/odoo_19.conf"
        ODOO_LOG = "/home/odoo/workspace/odoo/odoo_19/odoo.log"
        DATABASE = "test"
        SOURCE_DIR = "/home/odoo/workspace/internal_project"
        PYLINT_MIN_SCORE = "3.0"
        ODOO_PORT = "8069"
    }

    stages {

        stage('Checkout Staging Branch') {
            steps {
                echo "=========================================="
                echo "CHECKING OUT STAGING BRANCH"
                echo "=========================================="

                checkout([
                    $class: 'GitSCM',
                    branches: [[name: '*/staging']],
                    userRemoteConfigs: scm.userRemoteConfigs,
                    extensions: [
                        [$class: 'CleanBeforeCheckout']
                    ]
                ])

                sh '''
                    set -e
                    echo "Current commit:"
                    git rev-parse HEAD
                    echo ""
                    echo "Staging branch commit:"
                    git rev-parse origin/staging

                    CURRENT_COMMIT=$(git rev-parse HEAD)
                    STAGING_COMMIT=$(git rev-parse origin/staging)

                    if [ "${CURRENT_COMMIT}" != "${STAGING_COMMIT}" ]; then
                        echo "ERROR: Jenkins did not checkout the latest staging commit."
                        exit 1
                    fi

                    echo "Staging branch checked out successfully."
                '''
            }
        }

        stage('Git Information') {
            steps {
                sh '''
                    set -e
                    echo "Current commit:"
                    git rev-parse HEAD
                    echo ""
                    echo "Commit message:"
                    git log -1 --pretty=%B
                    echo ""
                    echo "Commit author:"
                    git log -1 --pretty=format:'%an <%ae>'
                    echo ""
                    echo "Remote:"
                    git remote -v
                '''

                script {
                    def commitSha = sh(
                        script: 'git rev-parse HEAD',
                        returnStdout: true
                    ).trim()

                    def authorEmail = sh(
                        script: 'git log -1 --pretty=format:%ae',
                        returnStdout: true
                    ).trim()

                    def remoteUrl = sh(
                        script: 'git remote get-url origin',
                        returnStdout: true
                    ).trim()

                    def githubUrl = remoteUrl
                        .replaceFirst(/^git@github\.com:/, 'https://github.com/')
                        .replaceFirst(/^ssh:\/\/git@github\.com\//, 'https://github.com/')
                        .replaceFirst(/\.git$/, '')

                    env.COMMIT_SHA = commitSha
                    env.COMMIT_AUTHOR_EMAIL = authorEmail
                    env.GITHUB_COMMIT_URL = "${githubUrl}/commit/${commitSha}"

                    echo "Commit author email: ${env.COMMIT_AUTHOR_EMAIL}"
                    echo "GitHub commit URL: ${env.GITHUB_COMMIT_URL}"
                }
            }
        }

        stage('Detect Changed Modules') {
            steps {
                script {
                    def currentCommit = sh(
                        script: 'git rev-parse HEAD',
                        returnStdout: true
                    ).trim()

                    def previousCommit = sh(
                        script: 'git rev-parse HEAD~1 2>/dev/null || git rev-parse HEAD',
                        returnStdout: true
                    ).trim()

                    echo "Previous commit: ${previousCommit}"
                    echo "Current commit: ${currentCommit}"

		    def changedFiles = withEnv([
		        "PREVIOUS_COMMIT=${previousCommit}",
		        "CURRENT_COMMIT=${currentCommit}"
		    ]) {
		        sh(
			    script: '''#!/bin/bash
			        set -e
			        set -o pipefail

			        git diff --name-only "$PREVIOUS_COMMIT" "$CURRENT_COMMIT" |
				    grep -v '__pycache__/' |
				    grep -v '\\.pyc$' |
				    grep -v '^Jenkinsfile$' |
				    grep -v '^jenkinsfile$' |
				    grep -v '^Jenkinsfile\\.staging$' |
				    grep -v '^Jenkinsfile\\.dev$' |
				    grep -v '^\\.gitignore$' || true
			    ''',
			    returnStdout: true
		        ).trim()
		    }

                    echo "Changed files:"
                    if (changedFiles) {
                        echo changedFiles
                    } else {
                        echo "No files changed."
                    }

                    def modules = []

                    if (changedFiles) {
                        changedFiles.split('\n').each { changedFile ->
                            if (
                                !changedFile.contains('__pycache__/') &&
                                !changedFile.endsWith('.pyc') &&
                                changedFile != 'Jenkinsfile' &&
                                changedFile != 'jenkinsfile' &&
                                changedFile != '.gitignore'
                            ) {
                                def parts = changedFile.tokenize('/')

                                if (parts.size() >= 2) {
                                    def moduleName = parts[0]

                                    if (
                                        fileExists("${moduleName}/__manifest__.py") &&
                                        !modules.contains(moduleName)
                                    ) {
                                        modules.add(moduleName)
                                    }
                                }
                            }
                        }
                    }

                    env.CHANGED_MODULES = modules.join(' ')

                    echo "Changed Odoo modules:"
                    if (env.CHANGED_MODULES?.trim()) {
                        echo env.CHANGED_MODULES
                    } else {
                        echo "No Odoo modules changed."
                    }
                }
            }
        }

        stage('Pylint Check') {
            when {
                expression { return env.CHANGED_MODULES?.trim() }
            }

            steps {
                sh '''
                    set -e

                    echo "Python version:"
                    ${PYTHON} --version

                    echo ""
                    echo "Pylint version:"
                    ${PYTHON} -m pylint --version

                    for module in ${CHANGED_MODULES}
                    do
                        echo "Checking module: ${module}"

                        ${PYTHON} -m pylint \
                            --fail-under=${PYLINT_MIN_SCORE} \
                            ${module}
                    done

                    echo "Pylint check passed."
                '''
            }
        }

        stage('Pylint-Odoo Check') {
            when {
                expression { return env.CHANGED_MODULES?.trim() }
            }
            steps {
                script {
                    echo "Running pylint-odoo on changed modules: ${env.CHANGED_MODULES}"
                    def modules = env.CHANGED_MODULES.split()
                    for (module in modules) {
                        echo "Running pylint-odoo for module: ${module}"
                        sh """
                            ${PYTHON} -m pylint \\
                                --load-plugins=pylint_odoo \\
                                --fail-under=3.0 \\
                                "${SOURCE_DIR}/${module}"
                        """
                    }
                }
            }
        }

        stage('Flake8 Check') {
            when {
                expression {
                    return env.CHANGED_MODULES?.trim()
                }
            }

            steps {
                script {
                    echo "=========================================="
                    echo "FLAKE8 CHECK"
                    echo "=========================================="
                    echo "Changed modules: ${env.CHANGED_MODULES}"

                    sh '''
                        set -e

                        echo ""
                        echo "Python:"
                        ${PYTHON} --version

                        echo ""
                        echo "Flake8:"
                        ${PYTHON} -m flake8 --version

                        echo ""
                        echo "Running Flake8..."
                        echo "------------------------------------------"

                        for module in ${CHANGED_MODULES}
                        do
                            echo ""
                            echo "Checking module: ${module}"
                            ${PYTHON} -m flake8 ${module}
                        done

                        echo ""
                        echo "=========================================="
                        echo "Flake8 check passed."
                        echo "=========================================="
                    '''
                }
            }
        }

        stage('Deploy Custom Addons') {
            when {
                expression { return env.CHANGED_MODULES?.trim() }
            }
            steps {
                sh '''
                    set -e
                    echo "Jenkins workspace:"
                    pwd
                    echo "Target directory: ${SOURCE_DIR}"
                    test -d "${SOURCE_DIR}"
                    echo "Modules to deploy: ${CHANGED_MODULES}"

                    for module in ${CHANGED_MODULES}
                    do
                        echo "Deploying module: ${module}"
                        if [ ! -d "${module}" ]; then
                            echo "ERROR: Module ${module} does not exist in Jenkins workspace."
                            exit 1
                        fi
                        sudo -n -u odoo rsync -a \
                            --delete \
                            --no-owner \
                            --no-group \
                            "${module}/" \
                            "${SOURCE_DIR}/${module}/"
                        sudo -n chown -R odoo:odoo "${SOURCE_DIR}/${module}"
                        echo "Module deployed: ${module}"
                    done
                    echo "Custom addons deployed successfully."
                '''
            }
        }

        stage('Stop Odoo') {
            when {
                expression { return env.CHANGED_MODULES?.trim() }
            }
            steps {
                sh '''
                    set -e
                    echo "Stopping Odoo using systemd..."
                    sudo -n systemctl stop odoo
                    echo "Checking Odoo service state..."
                    if sudo -n systemctl is-active --quiet odoo; then
                        echo "ERROR: Odoo service is still running."
                        sudo -n systemctl status odoo --no-pager || true
                        exit 1
                    fi
                    echo "Odoo service stopped successfully."
                '''
            }
        }

        stage('Upgrade Odoo Modules') {
            when {
                expression { return env.CHANGED_MODULES?.trim() }
            }

            steps {
                sh '''
                    set -e

                    if [ ! -f "${ODOO_CONFIG}" ]; then
                        echo "ERROR: Odoo config not found: ${ODOO_CONFIG}"
                        exit 1
                    fi

                    if [ ! -f "${ODOO_BIN}" ]; then
                        echo "ERROR: Odoo binary not found: ${ODOO_BIN}"
                        exit 1
                    fi

                    MODULES_TO_UPGRADE=$(echo "${CHANGED_MODULES}" | tr ' ' ',')

                    echo "Database: ${DATABASE}"
                    echo "Modules to upgrade: ${MODULES_TO_UPGRADE}"

                    sudo -n -u odoo \
                        "${PYTHON}" \
                        "${ODOO_BIN}" \
                        -c "${ODOO_CONFIG}" \
                        -d "${DATABASE}" \
                        -u "${MODULES_TO_UPGRADE}" \
                        --stop-after-init

                    echo "Odoo module upgrade completed successfully."
                '''
            }
        }

        stage('Start Odoo') {
            when {
                expression { return env.CHANGED_MODULES?.trim() }
            }
            steps {
                sh '''
                    set -e
                    echo "Starting Odoo using systemd..."
                    sudo -n systemctl start odoo
                    echo "Waiting for Odoo service..."
                    for i in $(seq 1 30)
                    do
                        if sudo -n systemctl is-active --quiet odoo; then
                            echo "Odoo service is active."
                            break
                        fi
                        echo "Waiting for Odoo service... (${i}/30)"
                        sleep 1
                    done
                    if ! sudo -n systemctl is-active --quiet odoo; then
                        echo "ERROR: Odoo service failed to start."
                        sudo -n systemctl status odoo --no-pager || true
                        echo "Last 100 lines of Odoo log:"
                        tail -100 "${ODOO_LOG}" || true
                        exit 1
                    fi
                    echo "Odoo service started successfully."
                '''
            }
        }

        stage('Odoo Server Check') {
            when {
                expression { return env.CHANGED_MODULES?.trim() }
            }
            steps {
                sh '''
                    set -e
                    echo "=========================================="
                    echo "ODOO SERVER CHECK"
                    echo "=========================================="
                    echo "Checking Odoo systemd service..."
                    sudo -n systemctl is-active --quiet odoo
                    echo "Odoo systemd service is active."
                    echo "Waiting for Odoo port ${ODOO_PORT}..."
                    for i in $(seq 1 30)
                    do
                        if ss -ltn | grep -q ":${ODOO_PORT} "; then
                            echo "Odoo port ${ODOO_PORT} is listening."
                            break
                        fi
                        echo "Waiting for Odoo port... (${i}/30)"
                        sleep 1
                    done
                    if ! ss -ltn | grep -q ":${ODOO_PORT} "; then
                        echo "ERROR: Odoo service is active but port ${ODOO_PORT} is not listening."
                        sudo -n systemctl status odoo --no-pager || true
                        echo "Last 100 lines of Odoo log:"
                        tail -100 "${ODOO_LOG}" || true
                        exit 1
                    fi
                    echo "Odoo server is running correctly."
                '''
            }
        }

        stage('Odoo Health Check') {
            when {
                expression { return env.CHANGED_MODULES?.trim() }
            }
            steps {
                sh '''
                    set -e

                    for i in $(seq 1 30)
                    do
                        if curl -fsS \
                            --max-time 5 \
                            "http://127.0.0.1:${ODOO_PORT}/web/database/selector" \
                            > /dev/null
                        then
                            echo "Odoo HTTP health check passed."
                            exit 0
                        fi

                        echo "Waiting for Odoo HTTP service... (${i}/30)"
                        sleep 2
                    done

                    echo "ERROR: Odoo HTTP health check failed."
                    tail -100 "${ODOO_LOG}" || true
                    exit 1
                '''
            }
        }
    }

    post {
        always {
            echo "=========================================="
            echo "STAGING PIPELINE FINISHED"
            echo "=========================================="
        }

        success {
            echo "=========================================="
            echo "STAGING PIPELINE SUCCESS"
            echo "=========================================="
            echo "Deployment completed successfully."
            echo "Branch: staging"
            echo "Changed modules: ${env.CHANGED_MODULES ?: 'None'}"
            echo "Commit: ${env.COMMIT_SHA ?: 'Unknown'}"
            echo "Commit author: ${env.COMMIT_AUTHOR_EMAIL ?: 'Unknown'}"
            echo "=========================================="

            emailext(
                recipientProviders: [developers()],
                mimeType: 'text/html',
                subject: "[Jenkins] SUCCESS - ${env.JOB_NAME} #${env.BUILD_NUMBER}",
                body: """<html>
<body>
<p>Hello,</p>
<p>The Jenkins staging pipeline has completed successfully.</p>
<table>
<tr><td><b>Build Status:</b></td><td>SUCCESS</td></tr>
<tr><td><b>Job:</b></td><td>${env.JOB_NAME}</td></tr>
<tr><td><b>Build Number:</b></td><td>#${env.BUILD_NUMBER}</td></tr>
<tr><td><b>Branch:</b></td><td>${env.GITHUB_BRANCH}</td></tr>
<tr><td><b>Commit:</b></td><td>${env.COMMIT_SHA ?: 'Unknown'}</td></tr>
<tr><td><b>Commit Author:</b></td><td>${env.COMMIT_AUTHOR_EMAIL ?: 'Unknown'}</td></tr>
<tr><td><b>Changed Modules:</b></td><td>${env.CHANGED_MODULES ?: 'None'}</td></tr>
</table>
<p><b>GitHub Commit:</b> <a href="${env.GITHUB_COMMIT_URL ?: '#'}">${env.GITHUB_COMMIT_URL ?: 'Unavailable'}</a></p>
<p><b>Jenkins Build:</b> <a href="${env.BUILD_URL}">${env.BUILD_URL}</a></p>
<p>The Odoo custom addons were deployed and the Odoo server health check completed successfully.</p>
<p>Regards,<br>Jenkins CI/CD</p>
</body>
</html>""",
                attachLog: false
            )

            echo "Success notification email sent."
        }

        failure {
            echo "=========================================="
            echo "STAGING PIPELINE FAILED"
            echo "=========================================="
            echo "One of the CI/CD stages failed."
            echo "Deployment did not complete successfully."
            echo "Branch: staging"
            echo "Changed modules: ${env.CHANGED_MODULES ?: 'None'}"
            echo "Commit: ${env.COMMIT_SHA ?: 'Unknown'}"
            echo "Commit author: ${env.COMMIT_AUTHOR_EMAIL ?: 'Unknown'}"
            echo "Check the Jenkins console log for the exact failure reason."
            echo "Odoo log: ${env.ODOO_LOG}"
            echo "=========================================="

            emailext(
                recipientProviders: [developers()],
                mimeType: 'text/html',
                subject: "[Jenkins] FAILED - ${env.JOB_NAME} #${env.BUILD_NUMBER}",
                body: """<html>
<body>
<p>Hello,</p>
<p>The Jenkins staging pipeline has <b>failed</b>.</p>
<table>
<tr><td><b>Build Status:</b></td><td>FAILED</td></tr>
<tr><td><b>Job:</b></td><td>${env.JOB_NAME}</td></tr>
<tr><td><b>Build Number:</b></td><td>#${env.BUILD_NUMBER}</td></tr>
<tr><td><b>Branch:</b></td><td>${env.GITHUB_BRANCH}</td></tr>
<tr><td><b>Commit:</b></td><td>${env.COMMIT_SHA ?: 'Unknown'}</td></tr>
<tr><td><b>Commit Author:</b></td><td>${env.COMMIT_AUTHOR_EMAIL ?: 'Unknown'}</td></tr>
<tr><td><b>Changed Modules:</b></td><td>${env.CHANGED_MODULES ?: 'None'}</td></tr>
</table>
<p><b>GitHub Commit:</b> <a href="${env.GITHUB_COMMIT_URL ?: '#'}">${env.GITHUB_COMMIT_URL ?: 'Unavailable'}</a></p>
<p><b>Jenkins Build:</b> <a href="${env.BUILD_URL}">${env.BUILD_URL}</a></p>
<p><b>Failure information:</b><br>The pipeline stopped because one of its CI/CD stages returned an error. The exact failure reason is included in the Jenkins console output below.</p>
<hr>
<p><b>Last 100 lines of Jenkins console output:</b></p>
<pre>\${BUILD_LOG, maxLines=100, escapeHtml=true}</pre>
<p><b>Odoo log:</b> ${env.ODOO_LOG}</p>
<p>Regards,<br>Jenkins CI/CD</p>
</body>
</html>""",
                attachLog: true
            )

            echo "Failure notification email sent."
        }
    }
}
